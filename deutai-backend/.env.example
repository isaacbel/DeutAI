# ── DeutAI Backend · Environment Variables Template ──────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — rotate any keys that were exposed.

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL — Neon / Supabase / Render / local
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set to 0 to disable SSL verification in local dev only:
# DATABASE_SSL=0

# PostgreSQL pool tuning (optional — defaults shown)
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=20000

# JWT secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_bytes_hex
JWT_REFRESH_SECRET=replace_with_different_64_random_bytes_hex

# AI provider API keys (at least GROQ_API_KEY or one other is required)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email (SMTP — used for password-reset emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM=DeutAI <noreply@yourdomain.com>

# Frontend origin — used in CORS and password-reset links
FRONTEND_URL=http://localhost:3000
